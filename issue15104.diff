+    QUnit.test('Reference column selection', function(assert) {
+        var field = {
+            name: 'origin',
+            get_client: record => record.value,
+            get_domain: () => [],
+        };
+        var model = {fields: {origin: field}};
+        var column = new Sao.View.Tree.ReferenceColumn(model, {
+            name: 'origin',
+            selection: [['sale.sale', 'Sale']],
+        });
+        var record = {
+            value: ['sale.sale', 'S001'],
+            _get_on_change_args: () => ({}),
+        };
+        var cell = column.get_cell();
+        column.update_text(cell, record);
+        assert.strictEqual(cell.children('a').text(), 'Sale,S001');
+        assert.strictEqual(cell.children('a').attr('title'), 'Sale,S001');
+        assert.strictEqual(column.get_textual_value(record), 'Sale,S001');
+
+        record.value = ['unknown.model', 'Unknown'];
+        column.update_text(cell, record);
+        assert.strictEqual(cell.children('a').text(), 'unknown.model,Unknown');
+        record.value = ['', 'Free text'];
+        column.update_text(cell, record);
+        assert.strictEqual(cell.children('a').text(), 'Free text');
+        record.value = null;
+        column.update_text(cell, record);
+        assert.strictEqual(cell.children('a').text(), '');
+    });
+
