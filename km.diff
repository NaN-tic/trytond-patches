+msgctxt "model:ir.message,text:msg_field_string"
+msgid "%(field)s (string)"
+msgstr "%(field)s (អត្ថបទ)"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_forbidden_char_validation_record"
+msgid ""
+"The value \"%(value)s\" for field \"%(field)s\" in record \"%(record)s\" of "
+"\"%(model)s\" contains some invalid chars \"%(chars)s\"."
+msgstr ""
+"តម្លៃ «%(value)s» សម្រាប់វាល «%(field)s» ក្នុងកំណត់ត្រា «%(record)s» នៃ "
+"«%(model)s» មានតួអក្សរមិនត្រឹមត្រូវ «%(chars)s»។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_foreign_model_exist"
+msgid ""
+"The records could not be deleted because they are used by field \"%(field)s\""
+" of \"%(model)s\"."
+msgstr ""
+"មិនអាចលុបកំណត់ត្រាទាំងនេះបានទេ ព្រោះវាល «%(field)s» នៃ «%(model)s» "
+"កំពុងប្រើកំណត់ត្រាទាំងនេះ។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_foreign_model_missing"
+msgid "The value \"%(value)s\" for field \"%(field)s\" in \"%(model)s\" does not exist."
+msgstr "មិនមានតម្លៃ «%(value)s» សម្រាប់វាល «%(field)s» នៃ «%(model)s» ទេ។"
+
+msgctxt "model:ir.message,text:msg_html_editor_save_fail"
+msgid "Failed to save, please retry."
+msgstr "មិនអាចរក្សាទុកបានទេ។ សូមព្យាយាមម្ដងទៀត។"
+
+msgctxt "model:ir.message,text:msg_id_positive"
+msgid "ID must be positive."
+msgstr "ID ត្រូវតែជាចំនួនវិជ្ជមាន។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_import_data_missing_column"
+msgid "Missing values for last column at row %(row)d."
+msgstr "បាត់តម្លៃសម្រាប់ជួរឈរចុងក្រោយនៅជួរដេក %(row)d។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_import_data_missing_columns"
+msgid "Missing values for %(n)s last columns at row %(row)d."
+msgstr "បាត់តម្លៃសម្រាប់ជួរឈរចុងក្រោយចំនួន %(n)s នៅជួរដេក %(row)d។"
+
+msgctxt "model:ir.message,text:msg_language_code_unique"
+msgid "The code on language must be unique."
+msgstr "កូដភាសាត្រូវតែមានតែមួយគត់។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_language_default_translatable"
+msgid "The default language \"%(language)s\" must be translatable."
+msgstr "ភាសាលំនាំដើម «%(language)s» ត្រូវតែអនុញ្ញាតឱ្យផ្ទុកការបកប្រែ។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_language_delete_default"
+msgid "The default language \"%(language)s\" can not be deleted."
+msgstr "មិនអាចលុបភាសាលំនាំដើម «%(language)s» បានទេ។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_language_invalid_date"
+msgid "Invalid date format \"%(format)s\" for language \"%(language)s\"."
+msgstr ""
+"ទម្រង់កាលបរិច្ឆេទ «%(format)s» សម្រាប់ភាសា «%(language)s» មិនត្រឹមត្រូវ។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_language_invalid_grouping"
+msgid "Invalid grouping \"%(grouping)s\" for language \"%(language)s\"."
+msgstr ""
+"ការដាក់ខ្ទង់ជាក្រុម «%(grouping)s» សម្រាប់ភាសា «%(language)s» មិនត្រឹមត្រូវ។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_language_plural_invalid"
+msgid ""
+"Invalid plural \"%(plural)s\" for language \"%(language)s\" with exception "
+"\"%(exception)s\" and n %(n)r."
+msgstr ""
+"ទម្រង់ពហុវចនៈ «%(plural)s» សម្រាប់ភាសា «%(language)s» មិនត្រឹមត្រូវ "
+"ដោយមានករណីលើកលែង «%(exception)s» និង n = %(n)r។"
+
+msgctxt "model:ir.message,text:msg_last_modified_at"
+msgid "Last Modified at"
+msgstr "កែប្រែចុងក្រោយនៅ"
+
+msgctxt "model:ir.message,text:msg_model_data_db_id_model_unique"
+msgid "The database ID must be unique per model."
+msgstr "ID មូលដ្ឋានទិន្នន័យត្រូវតែមានតែមួយគត់ក្នុងម៉ូដែលនីមួយៗ។"
+
+msgctxt "model:ir.message,text:msg_model_data_xml_id_module_unique"
+msgid "The XML ID must be unique per module."
+msgstr "ID XML ត្រូវតែមានតែមួយគត់ក្នុងម៉ូឌុលនីមួយៗ។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_model_invalid_condition"
+msgid ""
+"The condition \"%(condition)s\" is not a valid PYSON expression for button "
+"rule \"%(rule)s\"."
+msgstr ""
+"លក្ខខណ្ឌ «%(condition)s» មិនមែនជាកន្សោម PYSON ត្រឹមត្រូវសម្រាប់ច្បាប់ប៊ូតុង "
+"«%(rule)s» ទេ។"
+
+msgctxt "model:ir.message,text:msg_module_deactivate_dependency"
+msgid "Some activated modules depend on the ones you are trying to deactivate:"
+msgstr "ម៉ូឌុលសកម្មមួយចំនួនពឹងផ្អែកលើម៉ូឌុលដែលអ្នកកំពុងព្យាយាមបិទដំណើរការ៖"
+
+msgctxt "model:ir.message,text:msg_module_delete_state"
+msgid ""
+"You can not remove a module that is activated or that is about to be "
+"activated."
+msgstr "អ្នកមិនអាចដកម៉ូឌុលដែលសកម្ម ឬរង់ចាំធ្វើឱ្យសកម្មចេញបានទេ។"
+
+msgctxt "model:ir.message,text:msg_notes"
+msgid "Notes"
+msgstr "កំណត់ចំណាំ"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_order_function_missing"
+msgid "Missing order function for field \"%(field)s\" in \"%(model)s\"."
+msgstr "បាត់អនុគមន៍តម្រៀបសម្រាប់វាល «%(field)s» ក្នុង «%(model)s»។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_read_error"
+msgid "You are trying to read records \"%(ids)s\" of \"%(model)s\" that don't exist."
+msgstr "អ្នកកំពុងព្យាយាមអានកំណត់ត្រា «%(ids)s» នៃ «%(model)s» ដែលមិនមាន។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_read_rule_error"
+msgid ""
+"You are not allowed to read records \"%(ids)s\" of \"%(model)s\" because of at least one of these rules:\n"
+"%(rules)s"
+msgstr ""
+"អ្នកមិនមានសិទ្ធិអានកំណត់ត្រា «%(ids)s» នៃ «%(model)s» ទេ ដោយសារច្បាប់យ៉ាងហោចណាស់មួយខាងក្រោម៖\n"
+"%(rules)s"
+
+msgctxt "model:ir.message,text:msg_record_name"
+msgid "Record Name"
+msgstr "ឈ្មោះកំណត់ត្រា"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_recursion_error"
+msgid ""
+"Recursion error: Record \"%(rec_name)s\" with parent \"%(parent_rec_name)s\" "
+"was configured as ancestor of itself."
+msgstr ""
+"កំហុសយោងវិលជុំ៖ កំណត់ត្រា «%(rec_name)s» ដែលមានកំណត់ត្រាមេ "
+"«%(parent_rec_name)s» ត្រូវបានកំណត់ជាកំណត់ត្រាបុព្វបុរសរបស់ខ្លួនឯង។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_reference_syntax_error"
+msgid ""
+"Syntax error for %(value)r in \"%(field)s\" of \"%(model)s\" at row %(row)d "
+"and column %(column)d."
+msgstr ""
+"មានកំហុសវាក្យសម្ពន្ធសម្រាប់ %(value)r ក្នុង «%(field)s» នៃ «%(model)s» "
+"នៅជួរដេកទី %(row)d និងជួរឈរទី %(column)d។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_relation_not_found"
+msgid ""
+"Could not find relation for %(value)r in \"%(model)s\" at row %(row)d and "
+"column %(column)d."
+msgstr ""
+"រកមិនឃើញទំនាក់ទំនងសម្រាប់ %(value)r ក្នុង «%(model)s» នៅជួរដេកទី %(row)d "
+"និងជួរឈរទី %(column)d។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_report_invalid_email"
+msgid "Invalid email definition for report \"%(name)s\"."
+msgstr "និយមន័យអ៊ីមែលសម្រាប់របាយការណ៍ «%(name)s» មិនត្រឹមត្រូវ។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_report_invalid_record_name"
+msgid ""
+"Invalid record name definition for report \"%(report)s\" with exception "
+"\"%(exception)s\"."
+msgstr ""
+"និយមន័យឈ្មោះកំណត់ត្រាសម្រាប់របាយការណ៍ «%(report)s» មិនត្រឹមត្រូវ "
+"ដោយមានករណីលើកលែង «%(exception)s»។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_required_validation"
+msgid "A value is required for field \"%(field)s\" in \"%(model)s\"."
+msgstr "ត្រូវបញ្ចូលតម្លៃសម្រាប់វាល «%(field)s» ក្នុង «%(model)s»។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_required_validation_record"
+msgid ""
+"A value is required for field \"%(field)s\" in record \"%(record)s\" of "
+"\"%(model)s\"."
+msgstr ""
+"ត្រូវបញ្ចូលតម្លៃសម្រាប់វាល «%(field)s» ក្នុងកំណត់ត្រា «%(record)s» នៃ "
+"«%(model)s»។"
+
+msgctxt "model:ir.message,text:msg_resource_copy_help"
+msgid "The resources to which this record must be copied."
+msgstr "ធនធានដែលត្រូវចម្លងកំណត់ត្រានេះទៅ។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_rule_invalid_domain"
+msgid "Invalid domain in rule \"%(name)s\"."
+msgstr "ដែនក្នុងច្បាប់ «%(name)s» មិនត្រឹមត្រូវ។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_search_function_missing"
+msgid "Missing search function for field \"%(field)s\" in \"%(model)s\"."
+msgstr "បាត់អនុគមន៍ស្វែងរកសម្រាប់វាល «%(field)s» ក្នុង «%(model)s»។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_selection_validation_record"
