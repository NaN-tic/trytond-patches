+
+msgctxt "model:web.user.authenticate.attempt,string:"
+msgid "Web User Authenticate Attempt"
+msgstr "ការព្យាយាមផ្ទៀងផ្ទាត់អ្នកប្រើគេហទំព័រ"
+
+msgctxt "model:web.user.session,string:"
+msgid "Web User Session"
+msgstr "វគ្គអ្នកប្រើគេហទំព័រ"
+
+msgctxt "report:web.user.email_reset_password:"
+msgid "Button not working? Paste this into your browser:"
+msgstr "ប៊ូតុងមិនដំណើរការមែនទេ? សូមចម្លងអត្ថបទនេះទៅក្នុងកម្មវិធីរុករករបស់អ្នក៖"
+
+#, python-format
+msgctxt "report:web.user.email_reset_password:"
+msgid ""
+"Hello, we received a request to reset the password for the account associated with [1:%(email)s]. No changes have been made to your account yet.[2:]\n"
+"                You can reset your password by clicking the link below:[3:]\n"
+"                [4:\n"
+"                    Reset Password\n"
+"                ]"
+msgstr ""
+"សួស្តី យើងបានទទួលសំណើកំណត់ពាក្យសម្ងាត់ឡើងវិញសម្រាប់គណនីដែលភ្ជាប់នឹង [1:%(email)s]។ គណនីរបស់អ្នកមិនទាន់ត្រូវបានកែប្រែទេ។[2:]\n"
+"                អ្នកអាចកំណត់ពាក្យសម្ងាត់ឡើងវិញដោយចុចតំណខាងក្រោម៖[3:]\n"
+"                [4:\n"
+"                    កំណត់ពាក្យសម្ងាត់ឡើងវិញ\n"
+"                ]"
+
+msgctxt "report:web.user.email_reset_password:"
+msgid "If you didn't make this request, you can ignore this email."
+msgstr "ប្រសិនបើអ្នកមិនបានធ្វើសំណើនេះទេ អ្នកអាចមិនអើពើនឹងអ៊ីមែលនេះ។"
+
+msgctxt "report:web.user.email_reset_password:"
+msgid "Reset Password"
+msgstr "កំណត់ពាក្យសម្ងាត់ឡើងវិញ"
+
+#, python-format
+msgctxt "report:web.user.email_reset_password:"
+msgid "The link will expire in [1:%(datetime)s]."
+msgstr "តំណនឹងផុតកំណត់នៅ [1:%(datetime)s]។"
+
+#, python-format
+msgctxt "report:web.user.email_validation:"
+msgid "%(email)s"
