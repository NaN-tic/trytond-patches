+msgstr "តម្លៃ"
+
+msgctxt "field:product.price_list,tax_included:"
+msgid "Tax Included"
+msgstr "រួមបញ្ចូលពន្ធ"
+
+msgctxt "field:product.price_list,unit:"
+msgid "Unit"
+msgstr "ឯកតា"
