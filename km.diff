+"%(error)s"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_fulfillment_fail"
+msgid ""
+"Failed to save fulfillment for sale \"%(sale)s\" with error:\n"
+"%(error)s"
+msgstr ""
+"មិនអាចរក្សាទុកការបំពេញទំនិញសម្រាប់ការលក់ «%(sale)s» បានទេ។ កំហុស៖\n"
+"%(error)s"
