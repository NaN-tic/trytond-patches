+"\"%(exception)s\"."
+msgstr ""
+"គំរូអ៊ីមែលមិនត្រឹមត្រូវក្នុងសកម្មភាព «%(activity)s» ដោយមានករណីលើកលែង "
+"«%(exception)s»។"
+
+#, python-format
+msgctxt "model:ir.message,text:msg_activity_invalid_email_title"
